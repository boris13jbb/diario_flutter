# Variables de entorno / dart-define para NotasPro
# Copia este archivo como referencia. No guardes secretos reales en el repositorio.
#
# Firebase se configura con `lib/firebase_options.dart` (FlutterFire).
# No uses este archivo para claves de Firebase Auth en cliente.

# Resumen con IA (opcional). Sin estas claves la app funciona igual.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Ejemplo de ejecución con defines:
# flutter run --dart-define=AI_API_KEY=tu_clave --dart-define=AI_MODEL=gpt-4o-mini
