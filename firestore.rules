rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function emailLower() {
      return request.auth.token.email == null
        ? ''
        : request.auth.token.email.lower();
    }

    function notePath(noteId) {
      return /databases/$(database)/documents/diary_entries/$(noteId);
    }

    function noteExists(noteId) {
      return exists(notePath(noteId));
    }

    function noteOwnerId(noteId) {
      return get(notePath(noteId)).data.user_id;
    }

    function isNoteOwner(noteId) {
      return isSignedIn()
        && noteId is string
        && noteId.size() > 0
        && noteExists(noteId)
        && noteOwnerId(noteId) == request.auth.uid;
    }

    function shareDocId(noteId) {
      // Misma fórmula que NoteShareService.accessDocId: noteId + '_' + email.lower().
      // Solo trim/lower; no se sustituyen caracteres (Rules no puede reproducir
      // transformaciones arbitrarias del cliente).
      return noteId + '_' + emailLower();
    }

    function isValidShareEmail(email) {
      return email is string
        && email.size() > 3
        && email == email.lower()
        && email.matches('.*@.*')
        && !email.matches('.*/.*');
    }

    function sharePath(noteId) {
      return /databases/$(database)/documents/shared_notes/$(shareDocId(noteId));
    }

    function isAuthorizedOnNote(noteId) {
      return isSignedIn()
        && emailLower().size() > 0
        && noteId is string
        && noteId.size() > 0
        && exists(sharePath(noteId))
        && get(sharePath(noteId)).data.note_id == noteId
        && get(sharePath(noteId)).data.shared_with_email == emailLower()
        && get(sharePath(noteId)).data.owner_id == noteOwnerId(noteId);
    }

    function canAccessNote(noteId) {
      return isNoteOwner(noteId) || isAuthorizedOnNote(noteId);
    }

    match /diary_entries/{entryId} {
      allow get, list: if isSignedIn()
        && request.auth.uid == resource.data.user_id;
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.user_id;
      // El UID debe ser dueño del documento actual y del resultante.
      // Así no se puede transferir la nota cambiando user_id.
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.user_id
        && request.auth.uid == request.resource.data.user_id;
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.user_id;
    }

    match /note_categories/{categoryId} {
      allow read: if isSignedIn()
        && request.auth.uid == resource.data.user_id;

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.user_id
        && request.resource.data.keys().hasAll(['user_id', 'name', 'color'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.color is int;

      allow update: if isSignedIn()
        && request.auth.uid == resource.data.user_id
        && request.auth.uid == request.resource.data.user_id
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.color is int;

      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.user_id;
    }

    match /user_settings/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /note_versions/{versionId} {
      allow read, delete: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
    }

    match /shared_notes/{shareId} {
      allow read: if isSignedIn() && (
        resource.data.owner_id == request.auth.uid ||
        resource.data.shared_with_email == emailLower()
      );
      allow create: if isSignedIn()
        && request.resource.data.owner_id == request.auth.uid
        && request.resource.data.note_id is string
        && request.resource.data.note_id.size() > 0
        && isValidShareEmail(request.resource.data.shared_with_email)
        && request.resource.data.permission in ['read', 'edit']
        && shareId == request.resource.data.note_id + '_' + request.resource.data.shared_with_email
        && noteExists(request.resource.data.note_id)
        && noteOwnerId(request.resource.data.note_id) == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.owner_id == request.auth.uid
        && request.resource.data.owner_id == resource.data.owner_id
        && request.resource.data.note_id == resource.data.note_id
        && request.resource.data.shared_with_email == resource.data.shared_with_email
        && request.resource.data.permission in ['read', 'edit'];
      allow delete: if isSignedIn()
        && resource.data.owner_id == request.auth.uid;
    }

    match /note_comments/{commentId} {
      // Propietario: la consulta debe filtrar owner_id == auth.uid.
      allow read: if isSignedIn()
        && resource.data.owner_id == request.auth.uid
        && resource.data.note_id is string;
      // Usuario autorizado sobre la nota vinculada.
      allow read: if isAuthorizedOnNote(resource.data.note_id)
        && resource.data.note_id is string
        && resource.data.owner_id is string;

      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.note_id is string
        && request.resource.data.owner_id is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && noteExists(request.resource.data.note_id)
        && request.resource.data.owner_id == noteOwnerId(request.resource.data.note_id)
        && canAccessNote(request.resource.data.note_id);

      allow update: if false;

      allow delete: if isSignedIn()
        && resource.data.note_id is string
        && (
          resource.data.user_id == request.auth.uid
          || isNoteOwner(resource.data.note_id)
        );
    }

    match /activity_logs/{logId} {
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
    }
  }
}
